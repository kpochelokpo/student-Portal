<%- include('../partials/header', { title: 'Manage Students', extraStyles: null }) %>
<section class="page-header">
  <h2>Manage Students</h2>
  <p>Create, update, or remove student records.</p>
</section>

<% if (message) { %>
  <div class="alert success"><%= message %></div>
<% } %>

<a class="button" href="/admin/students/new">Add Student</a>

<section class="card" style="margin-top:1rem;">
  <table class="table">
    <thead>
      <tr>
        <th>Index No</th>
        <th>Name</th>
        <th>Class</th>
        <th>Programme</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (students.length === 0) { %>
        <tr><td colspan="6">No students found.</td></tr>
      <% } %>
      <% students.forEach((student) => { %>
        <tr>
          <td><%= student.index_no %></td>
          <td><%= student.surname %> <%= student.firstname %></td>
          <td><%= student.class_name %></td>
          <td><%= student.programme %></td>
          <td><%= student.status %></td>
          <td>
            <a class="button light" href="/admin/students/<%= student.id %>/edit">Edit</a>
            <form method="POST" action="/admin/students/<%= student.id %>/reset-pin" style="display:inline;">
              <button class="button secondary" type="submit">Reset PIN</button>
            </form>
            <form method="POST" action="/admin/students/<%= student.id %>/delete" style="display:inline;">
              <button class="button danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
