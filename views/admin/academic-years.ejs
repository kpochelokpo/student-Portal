<%- include('../partials/head', { title: 'Academic Years' }) %>
<%- include('../partials/nav') %>
<section class="page">
  <div class="page-header">
    <h2>Manage Academic Years</h2>
    <p>Create or remove academic year records.</p>
  </div>

  <div class="card form-card">
    <form method="post" action="/admin/academic-years" class="form-row">
      <input name="name" type="text" placeholder="2025/2026" required>
      <button class="btn btn-primary" type="submit">Add Academic Year</button>
    </form>
  </div>

  <div class="card">
    <table class="results-table">
      <thead>
        <tr>
          <th>Academic Year</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% years.forEach((year) => { %>
          <tr>
            <td><%= year.name %></td>
            <td>
              <form class="inline-form" method="post" action="/admin/academic-years/<%= year.id %>/delete">
                <button class="btn btn-danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
