<%- include('../partials/header', { title: 'Academic Years', extraStyles: null }) %>
<section class="page-header">
  <h2>Academic Years</h2>
</section>

<section class="card">
  <form method="POST" action="/admin/academic-years" class="grid grid-2">
    <div class="form-group">
      <label>Academic Year</label>
      <input name="name" placeholder="2025/2026" required />
    </div>
    <div class="form-group" style="align-self:end;">
      <button class="button" type="submit">Add Year</button>
    </div>
  </form>
</section>

<section class="card" style="margin-top:1rem;">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
      </tr>
    </thead>
    <tbody>
      <% years.forEach((year) => { %>
        <tr>
          <td><%= year.name %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
