<%- include('../partials/header', { title: 'Audit Logs', extraStyles: null }) %>
<section class="page-header">
  <h2>Audit Logs</h2>
</section>

<section class="card">
  <table class="table">
    <thead>
      <tr>
        <th>User</th>
        <th>Action</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% logs.forEach((log) => { %>
        <tr>
          <td><%= log.username %></td>
          <td><%= log.action %></td>
          <td><%= log.timestamp %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
