<%- include('../partials/header', { title: 'Teacher Assignments', extraStyles: null }) %>
<section class="page-header">
  <h2>Teacher Assignments</h2>
  <p>Assign teachers to subjects and classes.</p>
</section>

<section class="card">
  <form method="POST" action="/admin/assignments" class="grid grid-2">
    <div class="form-group">
      <label>Teacher</label>
      <select name="teacher_id" required>
        <% teachers.forEach((teacher) => { %>
          <option value="<%= teacher.id %>"><%= teacher.surname %> <%= teacher.firstname %> (<%= teacher.staff_id %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label>Subject</label>
      <select name="subject_id" required>
        <% subjects.forEach((subject) => { %>
          <option value="<%= subject.id %>"><%= subject.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label>Class</label>
      <input name="class_name" required />
    </div>
    <div class="form-group">
      <label>Academic Year</label>
      <select name="academic_year_id" required>
        <% years.forEach((year) => { %>
          <option value="<%= year.id %>"><%= year.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group" style="align-self:end;">
      <button class="button" type="submit">Assign</button>
    </div>
  </form>
</section>

<section class="card" style="margin-top:1rem;">
  <table class="table">
    <thead>
      <tr>
        <th>Teacher</th>
        <th>Subject</th>
        <th>Class</th>
        <th>Academic Year</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% assignments.forEach((assignment) => { %>
        <tr>
          <td><%= assignment.teacher_name %></td>
          <td><%= assignment.subject %></td>
          <td><%= assignment.class_name %></td>
          <td><%= assignment.academic_year %></td>
          <td>
            <form method="POST" action="/admin/assignments/<%= assignment.id %>/delete">
              <button class="button danger" type="submit">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
