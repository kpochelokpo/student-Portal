<%- include('../partials/header', { title: 'Manage Subjects', extraStyles: null }) %>
<section class="page-header">
  <h2>Manage Subjects</h2>
</section>

<section class="card">
  <form method="POST" action="/admin/subjects" class="grid grid-2">
    <div class="form-group">
      <label>Subject Name</label>
      <input name="name" required />
    </div>
    <div class="form-group" style="align-self:end;">
      <button class="button" type="submit">Add Subject</button>
    </div>
  </form>
</section>

<section class="card" style="margin-top:1rem;">
  <table class="table">
    <thead>
      <tr>
        <th>Subject</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% subjects.forEach((subject) => { %>
        <tr>
          <td><%= subject.name %></td>
          <td>
            <form method="POST" action="/admin/subjects/<%= subject.id %>/delete">
              <button class="button danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
