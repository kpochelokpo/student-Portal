<%- include('../partials/head', { title: 'Manage Subjects' }) %>
<%- include('../partials/nav') %>
<section class="page">
  <div class="page-header">
    <h2>Manage Subjects</h2>
    <p>Create and remove subjects for result entry.</p>
  </div>

  <div class="card form-card">
    <form method="post" action="/admin/subjects" class="form-row">
      <input name="name" type="text" placeholder="Subject name" required>
      <button class="btn btn-primary" type="submit">Add Subject</button>
    </form>
  </div>

  <div class="card">
    <table class="results-table">
      <thead>
        <tr>
          <th>Subject</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% subjects.forEach((subject) => { %>
          <tr>
            <td><%= subject.name %></td>
            <td>
              <form class="inline-form" method="post" action="/admin/subjects/<%= subject.id %>/delete">
                <button class="btn btn-danger" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
