<%- include('../partials/header', { title: 'Login', extraStyles: null }) %>
<section class="hero">
  <div>
    <h2>Student Results Portal</h2>
    <p>Welcome to HALF ASSINI SENIOR HIGH SCHOOL. Sign in with your role to access academic results and management tools.</p>
    <div class="card">
      <h3>Login Instructions</h3>
      <ul>
        <li>Students: use Index Number and PIN.</li>
        <li>Teachers: use Username or Staff ID and password.</li>
        <li>Admins: use Username and password.</li>
      </ul>
    </div>
  </div>
  <div class="card login-card">
    <h3>Secure Login</h3>
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <div class="form-group">
        <label for="role">Select Role</label>
        <select name="role" id="role" required>
          <option value="student">Student</option>
          <option value="teacher">Teacher</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <div class="form-group">
        <label for="identifier">Username / Index Number / Staff ID</label>
        <input type="text" name="identifier" id="identifier" required />
      </div>
      <div class="form-group" id="password-field">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" />
      </div>
      <div class="form-group" id="pin-field" style="display: none;">
        <label for="pin">Student PIN</label>
        <input type="password" name="pin" id="pin" />
      </div>
      <button class="button" type="submit">Login</button>
    </form>
  </div>
</section>
<script>
  const roleSelect = document.getElementById('role');
  const passwordField = document.getElementById('password-field');
  const pinField = document.getElementById('pin-field');

  const toggleFields = () => {
    if (roleSelect.value === 'student') {
      passwordField.style.display = 'none';
      pinField.style.display = 'block';
    } else {
      passwordField.style.display = 'block';
      pinField.style.display = 'none';
    }
  };

  roleSelect.addEventListener('change', toggleFields);
  toggleFields();
</script>
<%- include('../partials/footer') %>
